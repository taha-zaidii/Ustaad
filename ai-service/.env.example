# Postgres connection (same Supabase pooler the Next.js app uses)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Shared bearer token. Next.js sends this in Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=changeme

# Host/port for the uvicorn server
HOST=0.0.0.0
PORT=8000

# Optional: log level
LOG_LEVEL=info
