# ─── Database (required) ──────────────────────────────────────────────────────
# Supabase transaction pooler URL. Used by lib/patterns/Singleton.ts and
# the AI service. Falls back to the Supabase JS REST adapter when unset.
DATABASE_URL=

# ─── Supabase (required if DATABASE_URL is unset) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Clerk auth (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── AI matching service (optional) ───────────────────────────────────────────
# Base URL of the FastAPI matching service (see /ai-service). If unset,
# /api/freelancers/match and /api/jobs/[id]/matches fall back to the
# local WeightedScoreMatching strategy and SQL ranking respectively.
AI_MATCHING_URL=
AI_SERVICE_TOKEN=
# One of: content | collaborative | hybrid. Default: hybrid.
AI_MATCH_STRATEGY=hybrid

# ─── Redis cache (optional) ───────────────────────────────────────────────────
# When unset, lib/cache/cacheAside.ts short-circuits and queries hit
# Postgres directly. With Redis attached, /api/jobs and /api/freelancers
# list endpoints serve from cache with 60s TTL and version-bump
# invalidation on job posts / profile updates.
REDIS_URL=
