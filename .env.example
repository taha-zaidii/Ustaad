# ─── Database (required) ──────────────────────────────────────────────────────
# Supabase transaction pooler URL. Used by lib/patterns/Singleton.ts and
# the AI service. Falls back to the Supabase JS REST adapter when unset.
DATABASE_URL=

# ─── Supabase (required if DATABASE_URL is unset) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Clerk auth (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── AI matching service (optional) ───────────────────────────────────────────
# Base URL of the FastAPI matching service (see /ai-service). If unset,
# /api/freelancers/match and /api/jobs/[id]/matches fall back to the
# local WeightedScoreMatching strategy and SQL ranking respectively.
AI_MATCHING_URL=
AI_SERVICE_TOKEN=
# One of: content | collaborative | hybrid. Default: hybrid.
AI_MATCH_STRATEGY=hybrid

# ─── Redis cache (optional, Upstash REST) ────────────────────────────────────
# When unset, lib/cache/cacheAside.ts short-circuits and queries hit
# Postgres directly. With Upstash attached, /api/jobs, /api/freelancers,
# and /api/categories serve from cache with 60s TTL and version-bump
# invalidation on job posts / profile updates.
#
# Grab both values from Upstash console → your DB → "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Payment providers (optional) ─────────────────────────────────────────────
# When STRIPE_SECRET_KEY is unset, the PaymentProvider factory routes
# 'stripe' requests to MockProvider (deterministic, no network) so the
# rest of the escrow lifecycle is testable end-to-end without credentials.
# Easypaisa / JazzCash currently always route to MockProvider — both
# require a B2B merchant contract before their API is reachable.
STRIPE_SECRET_KEY=
# Force-mock all providers regardless of which other keys are set.
# PAYMENTS_PROVIDER=mock
